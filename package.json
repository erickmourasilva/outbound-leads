{
  "name": "outbound-leads",
  "version": "0.1.0",
  "private": true,
  "description": "Outbound e extração de leads para o Instagram: extrai e segmenta clientes e parceiros, envia DMs aos poucos e acompanha tudo num painel local.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "python3 -m outbound setup",
    "doctor": "python3 -m outbound doctor",
    "dev": "portless outbound-leads python3 -m outbound serve",
    "serve": "python3 -m outbound serve",
    "db:init": "python3 -m outbound init",
    "db:seed": "python3 -m outbound seed",
    "leads:import": "python3 -m outbound import",
    "leads:export": "python3 -m outbound export",
    "stats": "python3 -m outbound stats",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "portless": "0.13.0"
  },
  "author": "Erick Moura",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erickmourasilva/outbound-leads.git"
  },
  "homepage": "https://github.com/erickmourasilva/outbound-leads",
  "bugs": {
    "url": "https://github.com/erickmourasilva/outbound-leads/issues"
  },
  "keywords": [
    "outbound",
    "lead-generation",
    "prospecting",
    "sales",
    "ai-agents",
    "claude-code-plugin"
  ]
}
